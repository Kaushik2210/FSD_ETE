PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Database Access -> user; Network Access -> allow your IP)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-idea-hub?retryWrites=true&w=majority

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
